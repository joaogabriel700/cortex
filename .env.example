# PRODUCTION ONLY (compose.prod.yaml). The demo, development and tests need no .env file.
# Copy to .env on the server. Never put passwords or keys in this file.

# Images and domain
GHCR_OWNER=
APP_VERSION=
APP_DOMAIN=
# Address range of the reverse proxy in front of the API
TRUSTED_PROXIES=

# Directory with the secret files, outside the repository (owner root, directory 0700, files 0444):
#   app_key, db_superuser_password, db_owner_password, db_runtime_password,
#   db_maintenance_password, mail_password, vapid_private_key
# Files for disabled features (mail, push) may be empty.
SECRETS_DIR=

# Database (defaults point to the bundled "db" service)
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# Mail (the password goes in SECRETS_DIR/mail_password)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_FROM_ADDRESS=

# Web Push (the private key goes in SECRETS_DIR/vapid_private_key)
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# Uploaded files: local or s3
FILESYSTEM_DISK=local
