<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force: container variables must never point the tests at another database. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="cortex_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- Real database drivers, so the tests exercise the runtime role grants. -->
        <env name="CACHE_STORE" value="database" force="true"/>
        <env name="QUEUE_CONNECTION" value="database" force="true"/>
        <env name="SESSION_DRIVER" value="database" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:8080" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
